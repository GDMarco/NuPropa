Cell["\<\
8*ALPHA*s12*conj(ALPHA)*conj(pow(SW2,-1/2.))*pow(mw2r,-1)*pow(pi,2)*
   ((-mw2r - 2*s12 + s13)*pow(mlsq,3) + pow(mlsq,4) + pow(mlsq,2)*(2*mw2r*s12 \
- 3*pow(mw2r,2) + pow(s12 - s13,2)) - 
     2*mw2r*(mw2r - s13)*(-2*mw2r*s12 + pow(mw2r,2) + pow(s12,2) + \
pow(s13,2)) + 
     mlsq*(-((4*s12 + 3*s13)*pow(mw2r,2)) + 5*pow(mw2r,3) + s13*pow(s12 - \
s13,2) + mw2r*(6*s12*s13 + pow(s12,2) + pow(s13,2))))*pow(mlsq - mw2r + \
s13,-2)*
   pow(mlsq - mw2r - s12 + s13,-2)*pow(SW2,-1/2.)\
\>", "Output",
