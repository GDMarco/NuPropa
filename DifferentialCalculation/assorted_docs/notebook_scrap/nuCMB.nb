   3.922323175357718*^9, {3.9239779473220987`*^9, 3.923978010444934*^9}},
 CellLabel->
  "Out[59]//CForm=",ExpressionUUID->"860c9119-bdd2-467c-91fd-2fdac09c600c"]
}, Open  ]],

