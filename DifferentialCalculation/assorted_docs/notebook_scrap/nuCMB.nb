Cell[BoxData[
 RowBox[{"ans", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"2", "^", "4"}], "*", "squaredAmp", "*", "chiz", "*", 
              RowBox[{"Conjugate", "[", "chiz", "]"}], "*", 
              RowBox[{"(", 
               RowBox[{"s12", "-", "mz2"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"s12", "-", 
                RowBox[{"Conjugate", "[", "mz2", "]"}]}], ")"}]}], "//.", 
             RowBox[{"Abbr", "[", "]"}]}], "/.", 
            RowBox[{
             RowBox[{"Den", "[", 
              RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"a", " ", "-", " ", "b"}], " ", ")"}]}]}]}], "/.", 
           "MomReplace"}], "/.", "Replacements2to2"}], "/.", 
         RowBox[{"m3sq", "->", "mfsq"}]}], "/.", 
        RowBox[{"m4sq", "->", "mfsq"}]}], "/.", 
       RowBox[{"MT2", "->", "mfsq"}]}], "]"}], "/.", 
     RowBox[{
      RowBox[{"s12", "-", "mz2"}], "->", 
      RowBox[{"1", "/", "chiz"}]}]}], "/.", 
    RowBox[{"gRu", "->", "gRf"}]}], "/.", 
   RowBox[{"gLu", "->", "gLf"}]}]}]], "Input",
 CellChangeTimes->{{3.922268808967937*^9, 3.922268892794525*^9}, {
   3.922268932835864*^9, 3.922269032387665*^9}, {3.9248469014769773`*^9, 
