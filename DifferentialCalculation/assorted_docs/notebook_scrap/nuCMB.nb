Cell["\<\
64*ALPHA*(2*MZ2C - s12 + s13)*conj(ALPHA)*(s12 - s13 - \
2*conj(MZ2C))*pow(gLnu,2)*pow(pi,2)*
   pow(MZ2C - s12,-1)*pow(s12 - s13,2)*pow(MZ2C + \
s13,-1)*pow(conj(gLnu),2)*pow(s12 - conj(MZ2C),-1)*
   pow(s13 + conj(MZ2C),-1)\
\>", "Output",
 CellChangeTimes->{{3.912153744472522*^9, 3.912153779375819*^9}, {
   3.912153827362885*^9, 3.912153843919639*^9}, {3.9121539100570173`*^9, 
   3.912153948693309*^9}, {3.922269042889453*^9, 3.922269046763741*^9}, 
   3.922323502811747*^9, 3.923977921294544*^9, 3.9239813554553947`*^9},
 CellLabel->
  "Out[68]//CForm=",ExpressionUUID->"ece1b736-8011-444c-8482-62db800acc76"]
}, Open  ]],

