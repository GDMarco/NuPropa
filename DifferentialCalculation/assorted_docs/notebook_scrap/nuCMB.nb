                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "^", "nweyl"}], ")"}], "*", "input"}], "//.", 
                    RowBox[{"Abbr", "[", "]"}]}], "//.", 
                    RowBox[{"SubExpr", "[", "]"}]}], "/.", "MomReplace"}], "/.",
                     "ConjugationList"}], ",", "Qe", ",", "nqed"}], "]"}], 
                   "*", 
