Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CForm", "[", "ans", "]"}], "/.", 
   RowBox[{"Conjugate", "->", "conj"}]}], "/.", 
  RowBox[{"Power", "->", "pow"}]}]], "Input",
 CellChangeTimes->{{3.912153729839582*^9, 3.912153778711411*^9}, {
