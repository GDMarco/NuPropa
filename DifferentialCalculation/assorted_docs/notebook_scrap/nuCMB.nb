Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CForm", "[", 
      RowBox[{"ans", "/.", 
       RowBox[{"Alfa2", "->", 
        RowBox[{"ALPHA", "*", 
         RowBox[{"Conjugate", "[", "ALPHA", "]"}]}]}]}], "]"}], "/.", 
     RowBox[{"Conjugate", "->", "conj"}]}], "/.", 
    RowBox[{"Power", "->", "pow"}]}], "/.", 
   RowBox[{"mz2", "->", "MZ2C"}]}], "/.", 
  RowBox[{"Pi", "->", "pi"}]}]], "Input",
