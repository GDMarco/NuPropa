  3.9218940441528587`*^9}, {3.9247471455898523`*^9, 3.924747186389048*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"5452f78b-eaec-4a82-93b4-ed5f7d88e1a4"],

Cell["\<\
3*(conj(gRf)*(2*gLf*mfsq*s24*s25*(s12*(s24 + s25) + s13*(-s13 + s24 + s25) - \
pow(s12,2)) + 
        2*gRf*mfsq*(s24 + s25)*(-(s12*s24*(2*s13 + 2*s15 + s25)) + \
s24*pow(s12,2) + 
           (s24 + s25)*pow(s13 + s15,2)) + 
        gRf*s13*s24*s25*(4*s13*s15 - 2*s12*(s13 + s15) - 2*s13*s24 - \
2*s15*s24 + pow(s12,2) + 
           2*pow(s13,2) + 2*pow(s15,2) + pow(s24,2)) - \
2*gLf*s13*pow(mfsq,2)*pow(s24 + s25,2)) + 
     conj(gLf)*(2*gRf*mfsq*s24*s25*(s12*(s24 + s25) + s13*(-s13 + s24 + s25) \
- pow(s12,2)) + 
        2*gLf*mfsq*(s24 + s25)*(-(s12*s24*(2*s15 + s25)) + s24*pow(s12,2) + \
(s24 + s25)*pow(s15,2)) + 
        gLf*s13*s24*s25*(2*s15*s25 - 2*s12*(s15 + s25) + pow(s12,2) + \
2*pow(s15,2) + pow(s25,2)) - 
        2*gRf*s13*pow(mfsq,2)*pow(s24 + s25,2)))\
\>", "Output",
 CellChangeTimes->{{3.9218948967021713`*^9, 3.92189490724387*^9}, 
   3.924746777906109*^9, {3.924747132592861*^9, 3.924747186771945*^9}},
 CellLabel->
  "Out[80]//CForm=",ExpressionUUID->"66771fd1-4cc5-4d66-b3e2-2168c653f439"]
}, Open  ]]
}, Closed]],

