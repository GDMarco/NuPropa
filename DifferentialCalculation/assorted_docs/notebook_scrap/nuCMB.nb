Cell[BoxData[
 FractionBox[
  RowBox[{"64", " ", "Alfa2", " ", 
   SuperscriptBox["gLnu", "2"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"s12", "-", "s13"}], ")"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     TemplateBox[{"gLnu", "\"*\""},
      "Superscript"], ")"}], "2"]}], 
  RowBox[{
