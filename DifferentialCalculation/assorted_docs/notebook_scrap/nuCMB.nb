Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ans", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"2", "^", "4"}], "*", "squaredAmp"}], "//.", 
             RowBox[{"Abbr", "[", "]"}]}], "/.", 
            RowBox[{
             RowBox[{"Den", "[", 
              RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"a", " ", "-", " ", "b"}], " ", ")"}]}]}]}], "/.", 
           "MomReplace"}], "/.", "Replacements2to2"}], "/.", 
         RowBox[{"m3sq", "->", "mfsq"}]}], "/.", 
        RowBox[{"m4sq", "->", "mfsq"}]}], "/.", 
       RowBox[{"MT2", "->", "mfsq"}]}], "]"}], "/.", 
     RowBox[{
      RowBox[{"s12", "-", "mz2"}], "->", 
      RowBox[{"1", "/", "chiz"}]}]}], "/.", 
    RowBox[{"gRu", "->", "gRf"}]}], "/.", 
   RowBox[{"gLu", "->", "gLf"}]}]}]], "Input",
 CellChangeTimes->{{3.922268808967937*^9, 3.922268892794525*^9}, {
   3.922268932835864*^9, 3.922269032387665*^9}, 3.9223232519515543`*^9},
 CellLabel->
  "In[975]:=",ExpressionUUID->"207660bc-e1c0-42a6-9c77-f1bdf594364b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"64", " ", "Alfa2", " ", 
   SuperscriptBox["gLnu", "2"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"s12", "-", "s13"}], ")"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     TemplateBox[{"gLnu", "\"*\""},
      "Superscript"], ")"}], "2"]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"mz2", "+", "s13"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"s13", "+", 
     TemplateBox[{"mz2", "\"*\""},
      "Superscript"]}], ")"}]}]]], "Output",
