Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ans", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"2", "^", "4"}], "*", "squaredAmp"}], "//.", 
             RowBox[{"Abbr", "[", "]"}]}], "/.", 
            RowBox[{
             RowBox[{"Den", "[", 
              RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"a", " ", "-", " ", "b"}], " ", ")"}]}]}]}], "/.", 
           "MomReplace"}], "/.", "Replacements2to2"}], "/.", 
         RowBox[{"m3sq", "->", "mfsq"}]}], "/.", 
        RowBox[{"m4sq", "->", "mfsq"}]}], "/.", 
       RowBox[{"MT2", "->", "mfsq"}]}], "]"}], "/.", 
     RowBox[{
      RowBox[{"s12", "-", "mz2"}], "->", 
      RowBox[{"1", "/", "chiz"}]}]}], "/.", 
    RowBox[{"gRu", "->", "gRf"}]}], "/.", 
   RowBox[{"gLu", "->", "gLf"}]}]}]], "Input",
 CellChangeTimes->{{3.922268808967937*^9, 3.922268892794525*^9}, {
   3.922268932835864*^9, 3.922269032387665*^9}, 3.9223232519515543`*^9},
 CellLabel->
  "In[967]:=",ExpressionUUID->"97a3fce2-2038-46b2-b76f-36b0b0b4d87e"],

Cell[BoxData[
 FractionBox[
  RowBox[{"64", " ", "Alfa2", " ", 
   SuperscriptBox["gLnu", "2"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"s12", "-", "s13"}], ")"}], "2"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     TemplateBox[{"gLnu", "\"*\""},
      "Superscript"], ")"}], "2"]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"mz2", "+", "s13"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"s13", "+", 
     TemplateBox[{"mz2", "\"*\""},
      "Superscript"]}], ")"}]}]]], "Output",
 CellChangeTimes->{{3.922268812209363*^9, 3.922268893327724*^9}, 
   3.922268943489581*^9, {3.9222689771467743`*^9, 3.922268984362502*^9}, {
   3.9222690215924377`*^9, 3.922269044793064*^9}, 3.922323252493552*^9},
