Cell["\<\
-8*ALPHA*conj(ALPHA)*pow(MW2C,-1)*pow(pi,2)*pow(MZ2C - s12,-1)*
   (conj(MW2C)*(s12 - conj(MZ2C) + 2*conj(gLf)*conj(gLnu)*(mfsq - s13 - \
conj(MW2C))*conj(SW2))*
      (mfsq*s12*(mfsq*(MZ2C - s12) + 4*gLnu*gRf*MW2C*(-mfsq + MW2C + \
s13)*SW2) + 
        2*MW2C*(MZ2C - s12 + 2*gLf*gLnu*(-mfsq + MW2C + s13)*SW2)*pow(s12 - \
s13,2)) + 
     (mfsq*s12 - mfsq*conj(MZ2C) + 4*conj(gLnu)*conj(gRf)*(mfsq - s13 - \
conj(MW2C))*conj(MW2C)*
         conj(SW2))*(mfsq*MW2C*s12*(MZ2C - s12 + 2*gLf*gLnu*(-mfsq + MW2C + \
s13)*SW2) + 
        ((4*gLnu*gRf*MW2C*(MW2C + s13)*SW2 + mfsq*(MZ2C - s12 - \
4*gLnu*gRf*MW2C*SW2))*pow(s13,2))/2.))*
   pow(-mfsq + MW2C + s13,-1)*pow(SW2,-1)*pow(mfsq - s13 - \
conj(MW2C),-1)*pow(conj(MW2C),-1)*
   pow(s12 - conj(MZ2C),-1)*pow(conj(SW2),-1)\
\>", "Output",
 CellChangeTimes->{{3.912153744472522*^9, 3.912153779375819*^9}, {
