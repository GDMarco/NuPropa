              RowBox[{"Eps", "[", "__", "]"}], ",", "Simplify"}], "]"}], "[", 
            
            RowBox[{"[", "1", "]"}], "]"}], "/.", "PassarinoId"}], "/.", 
          "EpsEtaReplace"}], "/.", "EpsRotReplace"}], "/.", 
