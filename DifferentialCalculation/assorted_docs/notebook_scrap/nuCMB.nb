Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"calculate", " ", "the", " ", "amplitude"}], ",", " ", 
    RowBox[{"but", " ", "turn", " ", "gauge", " ", "terms", " ", "off"}], ",",
     " ", 
    RowBox[{
    "and", " ", "allowing", " ", "for", " ", "complex", " ", "valued", " ", 
     "mz2", " ", "propagator"}]}], " ", "*)"}], "\[IndentingNewLine]", 
