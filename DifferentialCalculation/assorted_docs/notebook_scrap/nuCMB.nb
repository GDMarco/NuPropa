     RowBox[{"CForm", "[", 
      RowBox[{"ans", "/.", 
       RowBox[{"Alfa2", "->", 
        RowBox[{"ALPHA", "*", 
         RowBox[{"Conjugate", "[", "ALPHA", "]"}]}]}]}], "]"}], "/.", 
     RowBox[{"Conjugate", "->", "conj"}]}], "/.", 
    RowBox[{"Power", "->", "pow"}]}], "/.", 
   RowBox[{"mz2", "->", "MZ2C"}]}], "/.", 
  RowBox[{"Pi", "->", "pi"}]}]], "Input",
 CellChangeTimes->{{3.912153729839582*^9, 3.912153778711411*^9}, {
  3.91215382473659*^9, 3.912153859384335*^9}, {3.912153906027309*^9, 
  3.912153947992093*^9}, {3.9222690371285963`*^9, 3.922269042091807*^9}, {
  3.923977955933709*^9, 3.9239780100192966`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"963b0823-c610-47c2-a77d-b6ec2b1e592e"],

Cell["\<\
64*ALPHA*(2*MZ2C + s12)*conj(ALPHA)*(s12 + \
2*conj(MZ2C))*pow(gLnu,2)*pow(pi,2)*pow(s12,2)*
   pow(MZ2C + s12 - s13,-1)*pow(MZ2C + s13,-1)*pow(conj(gLnu),2)*pow(s12 - \
s13 + conj(MZ2C),-1)*
   pow(s13 + conj(MZ2C),-1)\
\>", "Output",
 CellChangeTimes->{{3.912153744472522*^9, 3.912153779375819*^9}, {
   3.912153827362885*^9, 3.912153843919639*^9}, {3.9121539100570173`*^9, 
