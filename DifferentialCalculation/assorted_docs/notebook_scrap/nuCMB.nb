Cell["\<\
4*ALPHA*conj(ALPHA)*(-2*ml1sq*ml2sq*MW2C*s12 + ml1sq*ml2sq*(ml1sq - ml2sq - \
s13)*s13 - 
     2*ml1sq*(ml2sq*s12 + 2*MW2C*(s12 - s13))*conj(MW2C) + 
     4*MW2C*(s12 - s13)*(ml2sq - s12 + s13)*conj(MW2C))*pow(MW2C,-1)*pow(pi,2)*
   pow(-ml1sq + MW2C + s13,-1)*pow(SW2,-1)*pow(ml1sq - s13 - \
conj(MW2C),-1)*pow(conj(MW2C),-1)*
   pow(conj(SW2),-1)\
\>", "Output",
