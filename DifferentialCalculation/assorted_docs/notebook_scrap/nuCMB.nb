            RowBox[{"(", 
             RowBox[{"mw2", "-", "s12", "+", "s13"}], ")"}], "2"]}], "+", 
          RowBox[{
           SuperscriptBox["ME2", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "mw2"}], "-", "s12", "+", "s13"}], ")"}]}]}], 
         ")"}]}], "+", 
