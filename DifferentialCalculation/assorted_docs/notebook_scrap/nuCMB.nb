           "MomReplace"}], "/.", "Replacements2to2"}], "/.", 
         RowBox[{"m3sq", "->", "mfsq"}]}], "/.", 
        RowBox[{"m4sq", "->", "mfsq"}]}], "/.", 
       RowBox[{"MT2", "->", "mfsq"}]}], "]"}], "/.", 
