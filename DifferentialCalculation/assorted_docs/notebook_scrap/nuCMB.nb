Cell[BoxData[
 FormBox[
  RowBox[{"192", " ", 
   SuperscriptBox["\[Pi]", "2"], " ", "Alfa2", " ", "chiz", " ", "gLnu", " ", 
   
   TemplateBox[{"chiz"},
    "Conjugate"], " ", 
   TemplateBox[{"gLnu"},
    "Conjugate"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      TemplateBox[{"gRf"},
       "Conjugate"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gLf", " ", "mfsq", " ", "s12"}], "+", 
        RowBox[{"gRf", " ", 
         SuperscriptBox["s13", "2"]}]}], ")"}]}], "+", 
     RowBox[{
      TemplateBox[{"gLf"},
       "Conjugate"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gLf", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"s12", "-", "s13"}], ")"}], "2"]}], "+", 
        RowBox[{"gRf", " ", "mfsq", " ", "s12"}]}], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.922268812209363*^9, 3.922268893327724*^9}, 
   3.922268943489581*^9, {3.9222689771467743`*^9, 3.922268984362502*^9}, {
   3.9222690215924377`*^9, 3.922269044793064*^9}, 3.923977947122644*^9, 
   3.928399168042674*^9, 3.928399230037506*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"897fa662-1ec1-4c89-9b8c-c5e2134fcdf6"]
}, Open  ]],

